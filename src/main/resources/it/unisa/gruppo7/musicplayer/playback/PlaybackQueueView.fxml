<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="queuePanel" prefWidth="250.0" styleClass="queue-container" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.gruppo7.musicplayer.playback.PlaybackQueueController">
    <children>
        <Label styleClass="queue-title" text="Coda di riproduzione">
            <VBox.margin><Insets bottom="10.0" left="10.0" top="10.0" /></VBox.margin>
        </Label>
        <ListView fx:id="queueListView" VBox.vgrow="ALWAYS" />
    </children>
</VBox>