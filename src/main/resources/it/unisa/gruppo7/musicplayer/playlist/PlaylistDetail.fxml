<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.gruppo7.musicplayer.playlist.PlaylistDetailController">
    <top>
        <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: #ececeb; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT">
                <StackPane fx:id="namePlaceholder" HBox.hgrow="ALWAYS">
                    <Label fx:id="playlistNameLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1c1c1e; -fx-cursor: hand;" text="Nome Playlist" />
                    <TextField fx:id="playlistNameField" managed="false" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1c1c1e; -fx-alignment: center;" visible="false" />
                </StackPane>

                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <Label fx:id="trackCountLabel" style="-fx-font-size: 14px; -fx-text-fill: #6e6e73;" text="0 Tracce" />
                    <Label fx:id="totalDurationLabel" style="-fx-font-size: 14px; -fx-text-fill: #6e6e73;" text="00:00" />
                </VBox>
            </HBox>

            <HBox spacing="10.0">
                <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #6e6e73; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="← Indietro" />

                <Button mnemonicParsing="false" onAction="#onPlayPlaylistClick" style="-fx-background-color: #e0592b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="▶ Riproduci" />

                <Button mnemonicParsing="false" onAction="#onAddTrackClick" style="-fx-background-color: #b4a0ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="+ Aggiungi" />

                <Button mnemonicParsing="false" onAction="#onRemoveTrackClick" style="-fx-background-color: #6e6e73; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="- Rimuovi" />
                <Button fx:id="manageTagsBtn" mnemonicParsing="false" onAction="#onManageTagsClick" style="-fx-background-color: #d722d1ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="Gestisci Tag" />
                <Button fx:id="deletePlaylistBtn" mnemonicParsing="false" onAction="#onDeletePlaylistClick" style="-fx-background-color: #d92d20; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand;" text="🗑 Elimina" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="playlistTrackTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <placeholder>
                <Label style="-fx-font-size: 16px; -fx-text-fill: #6e6e73;" text="Questa playlist è vuota. Aggiungi brani dalla libreria!" />
            </placeholder>
            <columns>
                <TableColumn fx:id="indexColumn" prefWidth="40.0" text="#" style="-fx-alignment: CENTER;" />
                
                <TableColumn fx:id="titleColumn" prefWidth="280.0" text="Titolo" />
                <TableColumn fx:id="authorColumn" prefWidth="180.0" text="Autore" />
                <TableColumn fx:id="durationColumn" prefWidth="100.0" text="Durata" />
                <TableColumn fx:id="tagColumn" prefWidth="120.0" text="Tag" />
            </columns>
        </TableView>
    </center>
</BorderPane>