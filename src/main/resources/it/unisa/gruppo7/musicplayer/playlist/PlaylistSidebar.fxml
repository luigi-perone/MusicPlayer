<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="234.0" spacing="2.0" styleClass="sidebar" stylesheets="@Playlist.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.gruppo7.musicplayer.playlist.PlaylistSidebarController">
    <VBox spacing="5.0" style="-fx-padding: 0 0 15 0;">
        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#onHomeClick" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="🏠  Home" />
        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#onLibraryClick" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="🎵  Libreria" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="section-head">
        <Label styleClass="section-title" text="Playlists" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="addBtn" onAction="#onAddToggle" styleClass="icon-btn" text="+">
            <tooltip>
                <Tooltip text="New Playlist" />
            </tooltip>
        </Button>
    </HBox>
   <ScrollPane hbarPolicy="NEVER" prefHeight="550.0" prefWidth="209.0" styleClass="home-scroll-pane">
      <content>
          <VBox fx:id="listBox" prefHeight="20.0" prefWidth="206.0" spacing="2.0" styleClass="list" />
      </content>
   </ScrollPane>
</VBox>
